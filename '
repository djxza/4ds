void horline(int x0, int x1, int y, u32 col, u32 *pixels) {
  for (int x = x0; x < x1; ++x) {
    putpixel(x, y, col, pixels);
  }
}

void draw_rectangle(int x0, int y0, int x1, int y1, u32 col, u32 *pixels) {
  int rx0, ry0, rx1, ry2;
  rx0 = x0 < x1 ? x0 : x1;
  rx1 = x0 < x1 ? x1 : x0;
  ry0 = y0 < y1 ? y0 : y1;
  ry1 = y0 < y1 ? y1 : y0;

  horline(x0, x1, y0, col, pixels);
  verline(x0, y0, y1, col, pixels);
  horline(x0, x1, y1, col, pixels);
  verline(x1, y0, y1, col, pixels);
}

// ------------------------------------------------------------
// Kernel entry point
// ------------------------------------------------------------
void _start(void) {
  // Validate framebuffer response
  if (fb_request.response == NULL ||
      fb_request.response->framebuffer_count < 1) {
    // No framebuffer available, halt forever
    for (;;) {
      __asm__ volatile("hlt");
    }
  }

  struct limine_framebuffer *fb = fb_request.response->framebuffers[0];

  uint32_t *pixels = (uint32_t *)fb->address;
  uint64_t width = fb->width;
  uint64_t height = fb->height;
  uint64_t pitch = fb->pitch / 4; // bytes -> pixels
                                  //
  screen.width = fb->width;
  screen.height = fb->height;
  screen.pitch = fb->pitch;

  // ------------------------------------------------------------
  // Draw a visible test pattern
  // ------------------------------------------------------------
  for (uint64_t y = 0; y < height; y++) {
    for (uint64_t x = 0; x < width; x++) {
      uint8_t r = (x ^ y) & 0xFF;
      uint8_t g = (x * 2) & 0xFF;
      uint8_t b = (y * 2) & 0xFF;

      // Pack RGB using framebuffer bit shifts
      uint32_t color = (r << fb->red_mask_shift) | (g << fb->green_mask_shift) |
                       (b << fb->blue_mask_shift);

      pixels[y * pitch + x] = 0x0;
    }
  }

  outl(COM1, screen.width);
  outl(COM1, screen.height);

  verline(100, 200, 500, 0x00DDDDAA, pixels);

  draw_rectangle(20, 20, 0, 0, 0x00DDDDDD, pixels);

  outb_putch('\n');
  outb_printu(screen.width);
  outb_putch('\n');
  outb_printu(screen.height);
  outb_putch('\n');

  char *titles[] = {"MARIO", "ZELDA", "FORTNITE"};

  // Hang so the image stays visible
  for (;;) {
    __asm__ volatile("hlt");
  }
}
