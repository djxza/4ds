#define COM1 0x3F8
#define PIC1_COMMAND 0x20
#define PIC_EOI 0x20

#include <stdint.h>

void hang() { __asm__("hlt"); }

static inline void outb(uint16_t port, uint8_t val) {
  __asm__ volatile("outb %0, %1" : : "a"(val), "Nd"(port));
}

inline uint8_t inb(uint16_t port) {
  uint8_t ret;
  __asm__ volatile("inb %1, %0" : "=a"(ret) : "Nd"(port));
  return ret;
}

static inline void outw(uint16_t port, uint16_t val) {
  __asm__ volatile("outw %0, %1" : : "a"(val), "Nd"(port));
}

static inline void outl(uint16_t port, uint32_t val) {
  __asm__ volatile("outl %0, %1" : : "a"(val), "Nd"(port));
}

void outb_putch(char c) { outb(COM1, c); }

void outb_prints(const char *s) {
  while (*s)
    outb_putch(*s++);
}

void outb_printu(unsigned int n) {
  char buf[10]; // Enough for 32-bit integer
  int i = 0;

  if (n == 0) {
    outb(COM1, '0');
    return;
  }

  // Convert to string in reverse
  while (n > 0) {
    buf[i++] = '0' + (n % 10);
    n /= 10;
  }

  // Print in correct order
  for (int j = i - 1; j >= 0; j--) {
    outb(COM1, buf[j]);
  }
}

void assert(bool expr, const char *msg) {
  if (!expr) {
    outb_prints(msg);
  }
}

#define assert_inited(st, msg) assert(st.init, msg)

// ------------------------------------------------------------
// Limine framebuffer request
// ------------------------------------------------------------
__attribute__((
    used)) static volatile struct limine_framebuffer_request fb_request = {
    .id = LIMINE_FRAMEBUFFER_REQUEST_ID, .revision = 0};

typedef uint32_t u32;
typedef uint64_t u64;

typedef struct {
  int width;
  int height;
  u64 pitch;
  bool init;
} screen_t;

static screen_t screen;

void putpixel(int x, int y, u32 col, u32 *pixels) {
  pixels[screen.width * y + x] = col;
}

void verline(int x, int y0, int y1, u32 col, u32 *pixels) {
  for (int y = y0; y < y1; ++y) {
    putpixel(x, y, col, pixels);
  }
}

// hotline
